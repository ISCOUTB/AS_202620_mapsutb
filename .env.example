# Copiar a .env y completar. .env está en .gitignore: nunca se versiona.
# En GitHub Actions estos mismos nombres existen como secrets del repositorio
# (Settings → Secrets and variables → Actions). Ver ADR 0009.
#
# Uso local:   flutter run --dart-define-from-file=.env
# Uso Docker:  docker compose --env-file .env -f infra/docker-compose.yml up --build

# Google Maps Platform (Geocoding + Static Maps). Restringir la key por
# referrer HTTP / paquete de la app en Google Cloud Console.
GOOGLE_MAPS_API_KEY=

# Google Analytics vinculado al proyecto de Firebase (flujo de datos web):
# Measurement ID (G-...) y un API secret del Measurement Protocol. Opcional.
GA_MEASUREMENT_ID=
GA_API_SECRET=
